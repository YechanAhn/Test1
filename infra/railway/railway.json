{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "services": [
    { "name": "orchestrator", "rootDirectory": "apps/orchestrator" },
    { "name": "shard-1",      "rootDirectory": "apps/shard" },
    { "name": "shard-2",      "rootDirectory": "apps/shard" },
    { "name": "shard-standby","rootDirectory": "apps/shard" }
  ]
}
