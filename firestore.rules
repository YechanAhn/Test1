rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 사용자 문서: 본인만 읽기/쓰기
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      // 파트너가 사용자 정보를 조회할 수 있도록 허용
      allow read: if request.auth != null &&
        exists(/databases/$(database)/documents/calendars/$(resource.data.calendarIds[0])) &&
        request.auth.uid in get(/databases/$(database)/documents/calendars/$(resource.data.calendarIds[0])).data.ownerIds;
    }

    // 캘린더 문서: 소유자만 읽기/쓰기
    match /calendars/{calendarId} {
      allow read, write: if request.auth != null &&
        request.auth.uid in resource.data.ownerIds;
      // 초대 코드로 조회 허용 (참여 시)
      allow read: if request.auth != null;
      // 새 캘린더 생성 허용
      allow create: if request.auth != null &&
        request.auth.uid in request.resource.data.ownerIds;
    }

    // 일정 문서: 캘린더 소유자만 읽기/쓰기
    match /events/{eventId} {
      allow read, write: if request.auth != null &&
        exists(/databases/$(database)/documents/calendars/$(resource.data.calendarId)) &&
        request.auth.uid in get(/databases/$(database)/documents/calendars/$(resource.data.calendarId)).data.ownerIds;
      allow create: if request.auth != null;
    }
  }
}
