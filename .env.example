# ─── Firebase / GCP Control Plane ────────────────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_STORAGE_BUCKET=
# 서버측 Admin SDK 는 파일 경로 대신 base64 또는 분리된 secret manager 권장
FIREBASE_ADMIN_CREDENTIALS_BASE64=
ALLOWED_UID=                 # Solo 모드 단일 사용자 UID 화이트리스트

# ─── Railway Runtime ─────────────────────────────────────────────
NATS_URL=                    # 1차 후보 (JetStream)
REDIS_URL=                   # Rate limit / cache / heartbeat

# ─── Exchange Keys (Read + Trade only, 출금 권한 절대 금지) ────────
BINANCE_KEY=
BINANCE_SECRET=
BINANCE_TESTNET=true
BYBIT_KEY=
BYBIT_SECRET=
BYBIT_TESTNET=true

# ─── Risk Guards (런타임 하드 리미트) ──────────────────────────────
MAX_NOTIONAL_USD=50
MAX_LEVERAGE=3
MAX_DRAWDOWN_PCT=5
KILL_SWITCH_DRAWDOWN_PCT=10

# ─── Notifications ────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
